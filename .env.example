# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/ticketing

# ── App ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-your-admin-password

# ── Paystack ─────────────────────────────────────────────────────────────
# Get these from: dashboard.paystack.com → Settings → API Keys & Webhooks
# Test keys start with sk_test_ / pk_test_
# Live keys start with sk_live_ / pk_live_  (swap these when Paystack approves you)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Currency: KES (Kenya), USD (international), GHS (Ghana), NGN (Nigeria)
PAYSTACK_CURRENCY=KES

# Flat service fee per ticket in the currency above (e.g. 200 = KES 200)
SERVICE_FEE_PER_TICKET=200

# ── Email ─────────────────────────────────────────────────────────────────
# Gmail: use an App Password (myaccount.google.com → Security → App passwords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=you@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM="My Events <you@gmail.com>"
